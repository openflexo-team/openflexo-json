use org.openflexo.ta.json.JSONTypedModelSlot as JSON;

import org.openflexo.ta.json.model.JSONDocument;
import org.openflexo.ta.json.model.JSONNode;
import org.openflexo.ta.json.metamodel.JSONSchemaDocument;
import org.openflexo.ta.json.metamodel.JSONSchemaType;

import java.lang.String;
import java.lang.Integer;

import JSONSchemaDocument PERSON_SCHEMA from ["http://www.openflexo.org/test/json/JSON/PersonGraph.schema.json"];

import JSONSchemaType PERSON_TYPE from [PERSON_SCHEMA:"Person"];
import JSONSchemaType COMPANY_TYPE from [PERSON_SCHEMA:"Company"];

typedef JSONIndividualType(schemaType=PERSON_TYPE) as Person;
typedef JSONIndividualType(schemaType=COMPANY_TYPE) as Company;

@URI("http://www.openflexo.org/projects/2025/11/JsonProjectTest_1764458135187.prj/TestPersonTyped.fml")
@Author("chahrazed")
public model TestPersonTyped {

  JSONDocument jsonModel with JSONTypedModelSlot(metaModel=PERSON_SCHEMA);

  JSONNode root with JSONNodeRole(container=jsonModel);

  create(required Resource<JSONDocument> jsonResource) {
    log "[TestPersonTyped] Creation de la VMI";

    connect jsonModel using parameters.jsonResource;
    root = jsonModel.rootNode;

    log "[TestPersonTyped] Root URI: " + root.getURI();
  }

  public void documentNodeString() {
    log root.getNodeWithKey("document").toString;
  }

  public JSONNode nodes() {
    return root.getNodeWithKey("nodes");
  }

  public JSONNode documentNode() {
    return root.getNodeWithKey("document");
  }

  public String documentName() {
    return this.documentNode().getNodeWithKey("name").node.asText;
  }

  public JSONNode references() {
    return root.getNodeWithKey("references");
  }

  public void printNodes() {
    log "[TestPersonTyped] Document name: " + this.documentName();
    log "[TestPersonTyped] Nodes size: " + this.nodes().children.size;
    log "[TestPersonTyped] References size: " + this.references().children.size;
  }

  public JSONNode nodeAt(int index) {
    return this.nodes().getArrayElementAt(parameters.index);
  }

  public JSONNode findNodeByName(String name) {
    for (JSONNode candidate : this.nodes().children) {
      if (candidate.getNodeWithKey("name").node.asText == parameters.name) {
        return candidate;
      }
    }
    return null;
  }

  delete() {
  }

  public concept PersonConcept {

    Person person with JSONIndividualRole(container=jsonModel, schemaType=PERSON_TYPE);

    create(required String name) {
      log "[PersonConcept] Recherche Person name=" + parameters.name;

      person = select unique Person from jsonModel
          where (selected.getNodeWithKey("name").node.asText == parameters.name);

      if (person == null) {
        log "[PersonConcept] Aucun noeud Person trouve";
        return;
      }

      log "[PersonConcept] Person trouvee: " + person;
      log "[PersonConcept] URI = " + person.getURI();
      log "[PersonConcept] id = " + this.id();
      log "[PersonConcept] name = " + this.name();
      log "[PersonConcept] age = " + this.age();
    }

    public String id() {
      return person.getNodeWithKey("id").node.asText;
    }

    public String name() {
      return person.getNodeWithKey("name").node.asText;
    }

    public Integer age() {
      return person.getNodeWithKey("age").node.asInt;
    }

    delete() {
    }
  }
}
