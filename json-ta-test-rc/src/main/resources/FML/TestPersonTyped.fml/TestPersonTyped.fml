use org.openflexo.ta.json.JSONModelSlot as JSON;

import org.openflexo.ta.json.model.JSONDocument;
import org.openflexo.ta.json.model.JSONNode;
import java.lang.String;
import java.lang.Integer;

@URI("http://www.openflexo.org/projects/2025/11/JsonProjectTest_1764458135187.prj/TestPersonTyped.fml")
@Author("chahrazed")
public model TestPersonTyped {

  JSONDocument jsonModel with JSONModelSlot();

  JSONNode root with JSONNodeRole(container=jsonModel);

  create(required Resource<JSONDocument> jsonResource) {
    log "Creation de la VMI";

    connect jsonModel using parameters.jsonResource;
    root = jsonModel.rootNode;

    log "Root URI: " + root.getURI();
    log "Document name: " + this.documentName();
    log "Nodes Number: " + this.nodes().children.size;
    log "References Number: " + this.references().children.size;
  }

  public void document() {
    log root.getNodeWithKey("document").node.toString;
  }

  public JSONNode nodes() {
    return root.getNodeWithKey("nodes");
  }

  public JSONNode references() {
    return root.getNodeWithKey("references");
  }

  public JSONNode nodeAt(Integer index) {
    return this.nodes().getArrayElementAt(parameters.index);
  }

  public String documentName() {
    return root.getNodeWithKey("document").getNodeWithKey("name").node.asText;
  }

  public void verifyPersonContent() {
    String docName = this.documentName();

    log "documentName = " + docName;
    log "documentName OK = " + (docName == "MyDocument");
    log "nodes is array = " + this.nodes().node.isArray();
    log "nodes size = " + this.nodes().children.size;
    log "references is array = " + this.references().node.isArray();
    log "references size = " + this.references().children.size;

    if (docName == "MyDocument"
        && this.nodes().node.isArray()
        && this.nodes().children.size == 2
        && this.references().node.isArray()
        && this.references().children.size == 1) {
      log "[verify Person Content] ==> true";
    }
    else {
      log "[verify Person Content] ==> false";
    }
  }

  public concept Person {

    JSONNode node with JSONNodeRole(container=jsonModel);

    create(required Integer index) {
      log "Creation depuis nodes[" + parameters.index + "]";

      node = root.getNodeWithKey("nodes").getArrayElementAt(parameters.index);

      if (node.getNodeWithKey("type").node.asText != "Person") {
        log "ERREUR: le node selectionne n'est pas une Person " + node.getNodeWithKey("type").node.asText;
        node = null;
        return;
      }

      log "Person URI: " + node.getURI();
      log "Person id: " + this.id();
      log "Person name: " + this.name();
      log "Person age: " + this.age();
    }

    public String id() {
      return node.getNodeWithKey("id").node.asText;
    }

    public String jsonType() {
      return node.getNodeWithKey("type").node.asText;
    }

    public String name() {
      return node.getNodeWithKey("name").node.asText;
    }

    public Integer age() {
      return node.getNodeWithKey("age").node.asInt;
    }

    delete() {
    }
  }

  delete() {
  }
}
