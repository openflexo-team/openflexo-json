{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://tuto/schemas/DistributedSystem.schema.json",
  "title": "DistributedSystem",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "components"],
  "properties": {
    "model": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "component": {
      "title": "Component",
      "type": "object",
      "required": ["id", "type", "name"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "name": { "type": "string" },
        "resources": {
          "type": "object",
          "properties": {
            "cpu": { "type": "integer" },
            "memoryMB": { "type": "integer" }
          }
        }
      }
    }
  }
}
